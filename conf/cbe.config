// CLIP/CBE cluster (VBC): SLURM + environment modules; AGAT runs in a singularity container
process {
    executor = 'slurm'

    withName: 'FASTP'                { module = 'build-env/f2022:fastp/0.23.4-gcc-12.2.0' }
    withName: 'UMI_DEDUP'            { module = 'build-env/f2022:bbmap/39.08-gcc-12.2.0' }
    withName: 'DOWNSAMPLE'           { module = 'build-env/f2021:seqtk/1.3-gcc-10.2.0' }
    withName: 'FASTQC'               { module = 'build-env/f2022:fastqc/0.11.9-java-11' }
    withName: 'STAR_ALIGN'           { module = 'build-env/f2022:star/2.7.11a-gcc-12.3.0' }
    withName: 'SALMON_QUANT_ALIGNED' { module = 'build-env/f2022:salmon/1.10.1-gcc-12.2.0:samtools/1.18-gcc-12.2.0' }
    withName: 'SALMON_QUANT_PSEUDO'  { module = 'build-env/f2022:salmon/1.10.1-gcc-12.2.0' }
    withName: 'DEEPTOOLS_CORRELATION'{ module = 'build-env/f2022:deeptools/3.5.4-foss-2022a' }
    withName: 'AGGREGATE_COUNTS|PIPELINE_STATS|MAKE_SAMPLESHEET' {
        module = 'build-env/f2022:python/3.10.8-gcccore-12.2.0'
    }
    withName: 'QC_PLOTS|PLOT_DEMUX'  { module = 'build-env/f2022:r-bundle-bioconductor/3.19-foss-2023b-r-4.4.1' }
    withName: 'MULTIQC'              { module = 'build-env/f2022:multiqc/1.14-foss-2021b' }
    withName: 'SPLIT_FASTQ_PAIRS|DEMULTIPLEX_CHUNK' {
        module = 'build-env/f2022:pigz/2.7-gcccore-12.2.0:python/3.10.8-gcccore-12.2.0'
    }

    // reference build
    withName: 'REF_GENOME'           { module = 'build-env/f2022:samtools/1.18-gcc-12.3.0' }
    withName: 'REF_ANNOTATION'       { module = 'build-env/2020:gffread/0.11.8-gcccore-8.3.0' }
    withName: 'AGAT_FIX|AGAT_EXTRACT'{ container = params.agat_container }
    withName: 'STAR_INDEX'           { module = 'build-env/f2022:star/2.7.11a-gcc-12.3.0:gffread/0.12.7-gcccore-12.2.0' }
    withName: 'SALMON_INDEX'         { module = 'build-env/f2022:salmon/1.10.1-gcc-12.2.0' }
    withName: 'DESEQ2_TABLES'        { module = 'build-env/f2021:bedtools/2.30.0-gcc-10.2.0' }
}

executor {
    queueSize       = 200
    submitRateLimit = '10/1sec'
}

singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = "${System.getenv('SCRATCHDIR') ?: System.getProperty('java.io.tmpdir')}/nxf_singularity"
}
