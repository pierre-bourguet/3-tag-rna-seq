// CBE.next cluster (VBC): Slurm; the tool versions of the cbe profile, from Galaxy BioContainers images (Apptainer), conda for the two
// processes that need two tools, environment modules for Python, R and pigz. QOS chosen from the task time.
def bc = '/cvmfs/singularity.galaxyproject.org/all'

process {
    executor       = 'slurm'
    queue          = 'c'
    clusterOptions = { task.time <= 1.h ? '--qos=rapid' : task.time <= 8.h ? '--qos=short' : task.time <= 48.h ? '--qos=medium' : '--qos=long' }

    withName: 'FASTP'                { container = "${bc}/fastp:0.23.4--hadf994f_3" }
    withName: 'UMI_DEDUP'            { container = "${bc}/bbmap:39.08--h92535d8_0" }
    withName: 'DOWNSAMPLE'           { container = "${bc}/seqtk:1.3--hed695b0_2" }
    withName: 'FASTQC'               { container = "${bc}/fastqc:0.11.9--hdfd78af_1" }
    withName: 'STAR_ALIGN'           { container = "${bc}/star:2.7.11a--h0033a41_0" }
    withName: 'SALMON_QUANT_ALIGNED' { conda = 'bioconda::salmon=1.10.1 bioconda::samtools=1.18' }
    withName: 'SALMON_QUANT_PSEUDO'  { container = "${bc}/salmon:1.10.1--hecfa306_2" }
    withName: 'DEEPTOOLS_CORRELATION'{ container = "${bc}/deeptools:3.5.4--pyhdfd78af_1" }
    withName: 'AGGREGATE_COUNTS|PIPELINE_STATS|MAKE_SAMPLESHEET' { module = 'Python/3.12.3-GCCcore-13.3.0' }
    withName: 'QC_PLOTS|PLOT_DEMUX'  { module = 'R-bundle-Bioconductor/3.20-foss-2024a-R-4.4.2' }
    withName: 'MULTIQC'              { container = "${bc}/multiqc:1.14--pyhdfd78af_0" }
    withName: 'SPLIT_FASTQ_PAIRS|DEMULTIPLEX_CHUNK' { module = 'pigz/2.8-GCCcore-14.3.0:Python/3.12.3-GCCcore-13.3.0' }

    // reference build (gffread 0.12.7 replaces 0.11.8 in REF_ANNOTATION: no image of 0.11.8)
    withName: 'REF_GENOME'           { container = "${bc}/samtools:1.18--hd87286a_0" }
    withName: 'REF_ANNOTATION'       { container = "${bc}/gffread:0.12.7--hdcf5f25_4" }
    withName: 'AGAT_FIX|AGAT_EXTRACT'{ container = params.agat_container }
    withName: 'STAR_INDEX'           { conda = 'bioconda::star=2.7.11a bioconda::gffread=0.12.7' }
    withName: 'SALMON_INDEX'         { container = "${bc}/salmon:1.10.1--hecfa306_2" }
    withName: 'DESEQ2_TABLES'        { container = "${bc}/bedtools:2.30.0--hc088bd4_0" }
}

executor {
    queueSize         = 200
    submitRateLimit   = '60/1min'
    pollInterval      = '30 sec'
    queueStatInterval = '2 min'
}

singularity {
    enabled    = true
    autoMounts = true
    cacheDir   = "${System.getenv('SCRATCHDIR') ?: System.getProperty('java.io.tmpdir')}/nxf_singularity"
}

conda {
    enabled  = true
    channels = ['conda-forge', 'bioconda']
    cacheDir = "${System.getenv('HOME')}/.conda/nextflow_envs"
}
