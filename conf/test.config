// Small end-to-end check: 2 samples x 10k reads (tests/data); combine with cbe: -profile cbe,test
params {
    samplesheet    = "${projectDir}/tests/data/samplesheet.csv"
    outdir         = "${System.getenv('SCRATCHDIR') ?: '.'}/tagseq_test_${params.te_annotation}"
    max_n_read     = 5000
    skip_deeptools = true
    min_reads_warn = 1000
}
