manifest {
    name            = '3-tag-rna-seq'
    description     = "3' tag-seq: demultiplexing, UMI collapsing, STAR + salmon quantification on AtRTD3 (ATTE or TEG), QC"
    homePage        = 'https://github.com/pierre-bourguet/3-tag-rna-seq'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '2.0.0'
}

params {
    // what to run: demultiplex, map, or demultiplex,map
    steps              = 'map'
    outdir             = null

    // map
    samplesheet        = null          // CSV sample,fastq[,well] or legacy headerless TSV fastq<TAB>sample
    te_annotation      = 'ATTE'        // ATTE (TAIR10 TEs, TEGs removed) or TEG (AtRTD3 TE genes)
    transgene          = null          // transgene set appended to the reference, e.g. mTurq
    reference_dir      = null          // overrides the te_annotation/transgene lookup below
    resources_dir      = new File("${projectDir}/../../resources").canonicalPath
    references_root    = "${params.resources_dir}/genomes/a_thaliana/AtRTD3/processed"
    adapters           = "${projectDir}/assets/adapter_fasta.fa"
    min_len            = 50
    max_len            = 150
    max_n_read         = 100000000
    seed               = 12345
    save_bam           = false
    skip_salmon_pseudo = false
    skip_bigwig        = false
    skip_deeptools     = false
    min_reads_warn     = 2500000
    ucsc_tools         = new File("${projectDir}/../../tools/UCSC").canonicalPath

    // demultiplex
    fastq_r1           = null
    fastq_r2           = null
    libraries          = null          // CSV library,fastq_1,fastq_2 (several lanes/libraries of the same plate)
    barcodes           = "${projectDir}/assets/barcodes_plate.txt"
    well_sheet         = null          // well,sample (or legacy sample<TAB>well)
    demux_chunk_reads  = 100000000

    // reference build (--build_reference)
    build_reference    = false
    atrtd3_gtf         = "${params.resources_dir}/genomes/a_thaliana/AtRTD3/raw/atRTD3_TS_21Feb22_transfix.gtf"
    genome_fasta       = "${params.resources_dir}/genomes/a_thaliana/AtRTD3/raw/TAIR10_chr_all.fas"
    tair10_gff         = "${params.resources_dir}/genomes/a_thaliana/TAIR10/raw/TAIR10_gff3/TAIR10_GFF3_genes_transposons.gff"
    tair10_te_table    = "${params.resources_dir}/genomes/a_thaliana/TAIR10/raw/TAIR10_transposable_elements/TAIR10_Transposable_Elements.txt"
    teg_table          = "${params.resources_dir}/genomes/a_thaliana/TAIR10/processed/te_annotation/TEG/TAIR10_transposable_element_genes_te_annotation.tsv"
    gene_annotations   = "${params.resources_dir}/genomes/a_thaliana/AtRTD3/processed/annotation_tables/Araport11_gene_ATTE_annotations.tsv"
    transgene_genome   = "${projectDir}/assets/transgenes/mTurq_3xcMyc_UBQ10_ter_pAlli_Venus.fas"
    transgene_cdna     = "${projectDir}/assets/transgenes/transgene_cDNAs.fas"
    transgene_gff      = "${projectDir}/assets/transgenes/mTurq_3xcMyc_UBQ10_ter_pAlli_Venus.gff"
    reference_outdir   = null          // default: <references_root>/tagseq_<te_annotation>[_<transgene>]
    index_outdir       = null          // default: <resources_dir>/indices/a_thaliana/AtRTD3_tagseq_<te_annotation>[_<transgene>]
    agat_container     = 'docker://quay.io/biocontainers/agat:1.0.0--pl5321hdfd78af_0'

    // derived, not meant to be set
    reference_name     = "tagseq_${params.te_annotation}" + (params.transgene ? "_${params.transgene}" : '')
    reference_out      = params.reference_outdir ?: "${params.references_root}/${params.reference_name}"
    index_out          = params.index_outdir ?: "${params.resources_dir}/indices/a_thaliana/AtRTD3_${params.reference_name}"
}

profiles {
    cbe  { includeConfig 'conf/cbe.config' }
    test { includeConfig 'conf/test.config' }
}

def trace_stamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
def info_dir = params.build_reference ? "${params.reference_out}/pipeline_info" : "${params.outdir}/pipeline_info"
timeline { enabled = true; file = "${info_dir}/timeline_${trace_stamp}.html" }
report   { enabled = true; file = "${info_dir}/report_${trace_stamp}.html" }
trace    { enabled = true; file = "${info_dir}/trace_${trace_stamp}.txt" }

process {
    shell         = ['/bin/bash', '-euo', 'pipefail']
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143, 247] ? 'retry' : 'finish' }
    maxRetries    = 2
}
